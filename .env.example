# Скопируйте в .env и заполните своими значениями
# Для docker compose DB_HOST=db и REDIS_HOST=redis (имена сервисов в compose)
# Для локального запуска DB_HOST=localhost и REDIS_HOST=localhost
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

REDIS_HOST=your_redis_host
REDIS_PORT=6379

DERIBIT_API_URL=https://www.deribit.com/api/v2
DERIBIT_TIMEOUT_SECONDS=10
TICKERS=["btc_usd","eth_usd"]
FETCH_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
